# =====================================================================================
#  FolioSense configuration — copy to `.env` and fill in.  `.env` is git-ignored.
#  Every service reads these via typed pydantic settings (libs/fm_common/fm_common/config.py
#  + services/*/…/config.py). Docker Compose passes this file to all containers.
# =====================================================================================

# ---------- General ----------
ENVIRONMENT=local                    # local | dev | staging | prod
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]

# ---------- Database (E33i) ----------
POSTGRES_USER=foliosense
POSTGRES_PASSWORD=change-me-db-password    # `python scripts/fm.py setup` generates one
POSTGRES_DB=foliosense
# That's all — connection URLs are built automatically from these three values.
# Docker uses host pgbouncer/postgres; `python scripts/fm.py dev` uses localhost:5432.
# Local PostgreSQL on another host/port (no-Docker mode)?  LOCAL_DB_HOST=localhost  LOCAL_DB_PORT=5432
# Advanced: a full DATABASE_URL=… still overrides everything.

# ---------- Docker host ports (what you open in the browser / pgAdmin) ----------
# `python scripts/fm.py up` checks each one before starting: if it is busy (or reserved by
# Windows) it picks the next free port and saves it here, so the URL stays stable.
FM_HTTP_PORT=8080          # the app  → http://localhost:8080
FM_GRAFANA_PORT=3001       # Grafana  (full `up` only)
FM_DB_PORT=55432           # Docker's PostgreSQL for pgAdmin/psql (your own PostgreSQL keeps 5432)

# ---------- Redis (cache L2, rate limiter, event bus, price stream) ----------
REDIS_URL=redis://redis:6379/0

# ---------- Security / Identity (E02) ----------
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900         # 15 min access tokens
REFRESH_TOKEN_TTL_DAYS=7             # rotating refresh tokens
COOKIE_SECURE=false                  # true when served over HTTPS
# Field encryption key for PAN numbers + AI API keys (32 bytes, urlsafe base64).
# Generate:  python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FM_ENCRYPTION_KEY=

# ---------- Login with Gmail (optional) ----------
# Set OIDC_ENABLED=true AND fill OIDC_CLIENT_ID / OIDC_CLIENT_SECRET to show the "Login with Gmail" button.
# Step-by-step (Google Cloud project, consent screen, OAuth client): docs/RUNNING.md → "Login with Gmail".
OIDC_ENABLED=false                  # true = show "Login with Gmail" (needs the client id + secret below)
OIDC_PROVIDER_NAME=google
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback
OIDC_POST_LOGIN_REDIRECT=http://localhost:8080/dashboard

# ---------- Rate limiting (E04) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300               # requests / window / user
RATE_LIMIT_AUTH=10                   # login/register attempts / window / IP
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Market data (E10/E11) ----------
MARKET_DATA_PROVIDER=yahoo           # yahoo (live NSE/BSE prices) | simulated (offline demo). MF NAVs always come from AMFI (mfapi.in)
MARKET_POLL_INTERVAL_SECONDS=5
# Company fundamentals: Yahoo (yfinance, then Yahoo's API directly) → Finnhub / Alpha Vantage (only if a key
# is set) → NSE's quote API. Later sources fill only what's still missing. Free Finnhub / Alpha Vantage plans
# mostly cover US listings; NSE/BSE fundamentals there usually need a paid plan.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# ---------- AI engines (E24 Multi-AI Review, E25 Narration) ----------
# Household-level keys can also be added in the web app (Settings → AI providers); those are
# stored encrypted in the DB and override these defaults. Leave blank to run "rules-only".
AI_PRIMARY_PROVIDER=claude           # claude | openai | gemini | groq | cloudflare | ollama | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=                        # set to the OpenAI model you want as reviewer
GEMINI_API_KEY=
GEMINI_MODEL=                        # set to the Gemini model you want as reviewer
GROQ_API_KEY=
GROQ_MODEL=                          # e.g. llama-3.3-70b-versatile
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=                    # e.g. @cf/meta/llama-3.3-70b-instruct-fp8-fast
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=                        # e.g. llama3.1 — only used if Ollama is running and has this model pulled
AI_REVIEW_MONTHLY_BUDGET_USD=10

# ---------- Observability ----------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------- Broker / order execution (Phase 3 — NOT used in Phase 1) ----------
ORDER_EXECUTION_ENABLED=false
